#!/usr/bin/env python3

import argparse
import logging
import os
import sys

REPO_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.append(os.path.join(REPO_DIR, "builder"))

# Make rpmsupport/strip_debug.sh available to the rpmbuild macros.
os.environ["PATH"] = os.path.join(REPO_DIR, "rpmsupport") + os.pathsep + os.environ.get("PATH", "")

import db
from build import PackageBuilder


parser = argparse.ArgumentParser(description='Build System')

# Subparsers
command_parsers = parser.add_subparsers(dest='command')
build_parser = command_parsers.add_parser('build')
query_parser = command_parsers.add_parser('query')

# build
build_parser.add_argument("package_name", nargs="+",
                          help="package name(s), LFS aliases, 'all', or a path to a .spec")
build_parser.add_argument("--jobs", type=int, default=0,
                          help="parallel package builds (0 = auto, default)")
# query
query_parser.add_argument("mode")
args = parser.parse_args()

pbuilder = PackageBuilder()

if args.command == "query":
    if args.mode == "failed":
        package_db = db.PackageDatabase()
        failed_packages = package_db.get_failed()
        for p in failed_packages:
            print(p[1])

if args.command == "build":
    names = args.package_name
    logging.basicConfig(level=logging.DEBUG)
    if names == ["all"]:
        pbuilder.build_all(jobs=args.jobs)
    elif len(names) == 1 and (names[0].endswith(".spec") or os.sep in names[0]):
        pbuilder.build_spec(names[0])
    else:
        pbuilder.build_packages(names, jobs=args.jobs)
