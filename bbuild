#!/usr/bin/env python3
"""Host-side package build helper.

This is a developer convenience for one-off host builds and for staging
sources/filelists into ~/rpmbuild/SOURCES.  Reproducible release builds run in
the container scripts (scripts/verify_base_in_container.sh,
scripts/build_desktop_stack.sh); bbuild is not the release path.
"""

import argparse
import logging
import os
import sys

REPO_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.append(os.path.join(REPO_DIR, "builder"))

import db
from build import PackageBuilder


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="Tenko host build helper")
    command_parsers = parser.add_subparsers(dest="command")

    build_parser = command_parsers.add_parser(
        "build", help="build packages on the host")
    build_parser.add_argument(
        "package_name", nargs="+",
        help="package name(s), base aliases, 'all' (the build_order base set), "
             "or a path to a .spec")
    build_parser.add_argument(
        "--jobs", type=int, default=0,
        help="parallel package builds (0 = auto, default)")

    query_parser = command_parsers.add_parser(
        "query", help="read the build database")
    query_parser.add_argument("mode", choices=["failed"])

    return parser, parser.parse_args(argv)


def summary(result):
    print()
    print("built:   {} package(s)".format(len(result["ok"])))
    print("failed:  {} package(s)".format(len(result["failed"])))
    print("unknown: {} package(s)".format(len(result["unknown"])))
    if result["conflicts"]:
        print("refused: {} NEVRA conflict(s)".format(len(result["conflicts"])))
        for nevra, names in sorted(result["conflicts"].items()):
            print("  {} -> {}".format(nevra, ", ".join(names)))
    for name in result["failed"]:
        print("  failed: {}".format(name))
    for name in result["unknown"]:
        print("  unknown: {}".format(name))


def report(result):
    summary(result)
    if result["failed"] or result["unknown"] or result["conflicts"]:
        return 1
    return 0


def main(argv=None):
    parser, args = parse_args(argv)

    if not args.command:
        parser.print_help()
        return 2

    if args.command == "query":
        try:
            package_db = db.PackageDatabase.read_only()
        except FileNotFoundError:
            print("no build database at {}".format(db.DEFAULT_DATABASE_PATH))
            return 0
        for package in package_db.get_failed():
            print(package[1])
        return 0

    logging.basicConfig(level=logging.INFO,
                        format="%(levelname)s %(name)s: %(message)s")
    builder = PackageBuilder()
    names = args.package_name

    if names == ["all"]:
        return report(builder.build_all(jobs=args.jobs))

    if len(names) == 1 and (names[0].endswith(".spec") or os.sep in names[0]):
        if builder.build_spec(names[0]):
            result = {"ok": [names[0]], "failed": [], "unknown": [],
                      "conflicts": {}}
        else:
            result = {"ok": [], "failed": [names[0]], "unknown": [],
                      "conflicts": {}}
        return report(result)

    return report(builder.build_packages(names, jobs=args.jobs))


if __name__ == "__main__":
    sys.exit(main())
