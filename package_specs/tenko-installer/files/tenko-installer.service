[Unit]
Description=Tenko Linux installer
Documentation=file:///usr/share/doc/tenko-installer/README
After=local-fs.target network-online.target
Wants=network-online.target
# kmscon is the base console on tty1.  Ordering is enough: a Conflicts= here
# would enqueue a stop job even when the live ConditionPathExists is false, and
# that would delete kmscon's start job on an installed system that happens to
# carry this package.
Before=getty@tty1.service kmsconvt@tty1.service
Conflicts=getty@tty1.service
ConditionPathExists=/run/initramfs/live

[Service]
Type=idle
Environment=TERM=linux
ExecStart=/usr/bin/tenko-installer
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
