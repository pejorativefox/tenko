%dir /etc/xdg
%dir /etc/xdg/dunst
%config(noreplace) /etc/xdg/dunst/dunstrc
%dir /usr/bin
/usr/bin/dunst
/usr/bin/dunstctl
%dir /usr/share
%dir /usr/share/bash-completion
%dir /usr/share/bash-completion/completions
/usr/share/bash-completion/completions/dunst
/usr/share/bash-completion/completions/dunstctl
/usr/share/bash-completion/completions/dunstify
%dir /usr/share/dbus-1
%dir /usr/share/dbus-1/services
/usr/share/dbus-1/services/dunst.service
%dir /usr/share/fish
%dir /usr/share/fish/vendor_completions.d
/usr/share/fish/vendor_completions.d/dunst.fish
/usr/share/fish/vendor_completions.d/dunstctl.fish
/usr/share/fish/vendor_completions.d/dunstify.fish
%dir /usr/share/man
%dir /usr/share/man/man1
%doc /usr/share/man/man1/dunst.1.gz
%doc /usr/share/man/man1/dunstctl.1.gz
%doc /usr/share/man/man1/dunstify.1.gz
%dir /usr/share/man/man5
%doc /usr/share/man/man5/dunst.5.gz
%dir /usr/share/zsh
%dir /usr/share/zsh/site-functions
/usr/share/zsh/site-functions/_dunst
/usr/share/zsh/site-functions/_dunstctl
/usr/share/zsh/site-functions/_dunstify
