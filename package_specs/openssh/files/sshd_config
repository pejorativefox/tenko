# Tenko Linux default sshd configuration (OpenSSH 10.5p1)
#
# Password authentication is enabled deliberately: Tenko ships Linux-PAM
# and expects remote administration to work after the first-boot root
# password is set.  Drop-in overrides belong in /etc/ssh/sshd_config.d/.

Include /etc/ssh/sshd_config.d/*.conf

# Host keys are generated on first boot by sshd-keygen.service.  DSA is not
# generated or accepted.
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Account policy
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
PermitEmptyPasswords no

# Authentication goes through Linux-PAM (/etc/pam.d/sshd).
UsePAM yes

# Forwarding
X11Forwarding yes
AllowTcpForwarding yes
AllowAgentForwarding yes

# Session
PrintMotd no
PrintLastLog yes
AcceptEnv LANG LC_*

Subsystem sftp /usr/libexec/sftp-server
