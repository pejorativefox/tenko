                 {
+                    workspaceTrackPendingPaint (screen_info, c);
                     clientShow (c, FALSE);
                 }
             }
@@ -341,7 +565,7 @@
             {
                 if (!clientIsTransientOrModal (c) || !clientTransientOrModalHasAncestor (c, new_ws))
                 {
-                    clientWithdraw (c, new_ws, FALSE);
+                    workspaceWithdrawClient (screen_info, c);
                 }
             }
         }
