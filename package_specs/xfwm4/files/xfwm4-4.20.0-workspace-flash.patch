+#ifdef HAVE_COMPOSITOR
+typedef struct
+{
+    Window window;
+    Damage damage;
+} WorkspacePendingPaint;
+#endif
+
+#define WORKSPACE_WITHDRAW_POLL_MS 10
+#define WORKSPACE_WITHDRAW_MAX_MS  100
+
+static void
+workspaceClearPendingPaint (ScreenInfo *screen_info)
+{
+#ifdef HAVE_COMPOSITOR
+    DisplayInfo *display_info;
+    GList *list;
+
+    display_info = screen_info->display_info;
+
+    for (list = screen_info->pending_paint; list; list = g_list_next (list))
+    {
+        WorkspacePendingPaint *pending = (WorkspacePendingPaint *) list->data;
+
+        XDamageDestroy (display_info->dpy, pending->damage);
+        g_free (pending);
+    }
+#endif
+    g_list_free (screen_info->pending_paint);
+    screen_info->pending_paint = NULL;
+}
+
+void
+workspaceClearPending (ScreenInfo *screen_info)
+{
+    g_return_if_fail (screen_info != NULL);
+
+    if (screen_info->pending_withdraw_timeout_id != 0)
+    {
+        g_source_remove (screen_info->pending_withdraw_timeout_id);
+        screen_info->pending_withdraw_timeout_id = 0;
+    }
+    g_list_free (screen_info->pending_withdraw);
+    screen_info->pending_withdraw = NULL;
+    workspaceClearPendingPaint (screen_info);
+}
+
+static void
+workspaceTrackPendingPaint (ScreenInfo *screen_info, Client *c)
+{
+#ifdef HAVE_COMPOSITOR
+    WorkspacePendingPaint *pending;
+
+    if (!compositorIsActive (screen_info))
+    {
+        return;
+    }
+
+    pending = g_new0 (WorkspacePendingPaint, 1);
+    pending->window = c->window;
+    pending->damage = XDamageCreate (myScreenGetXDisplay (screen_info),
+                                     c->window, XDamageReportNonEmpty);
+    if (pending->damage == None)
+    {
+        g_free (pending);
+        return;
+    }
+    screen_info->pending_paint = g_list_prepend (screen_info->pending_paint, pending);
+#else
+    (void) screen_info;
+    (void) c;
+#endif
+}
+
+static gboolean
+workspacePendingPaintDone (ScreenInfo *screen_info, Window window)
+{
+#ifdef HAVE_COMPOSITOR
+    DisplayInfo *display_info;
+    WorkspacePendingPaint *pending = NULL;
+    GList *list;
+    XserverRegion parts;
+    XRectangle *rects;
+    gint nrects;
+    gboolean done;
+
+    display_info = screen_info->display_info;
+
+    for (list = screen_info->pending_paint; list; list = g_list_next (list))
+    {
+        WorkspacePendingPaint *p = (WorkspacePendingPaint *) list->data;
+
+        if (p->window == window)
+        {
+            pending = p;
+            break;
+        }
+    }
+
+    if (pending == NULL)
+    {
+        /* Not waiting for this window: it was already painted before the
+           workspace switch. */
+        return TRUE;
+    }
+
+    parts = XFixesCreateRegion (display_info->dpy, NULL, 0);
+    XDamageSubtract (display_info->dpy, pending->damage, None, parts);
+    rects = XFixesFetchRegion (display_info->dpy, parts, &nrects);
+    done = (rects != NULL) && (nrects > 0);
+    if (rects)
+    {
+        XFree (rects);
+    }
+    XFixesDestroyRegion (display_info->dpy, parts);
+
+    if (done)
+    {
+        screen_info->pending_paint =
+            g_list_remove (screen_info->pending_paint, pending);
+        XDamageDestroy (display_info->dpy, pending->damage);
+        g_free (pending);
+    }
+    return done;
+#else
+    (void) screen_info;
+    (void) window;
+    return TRUE;
+#endif
+}
+
+static gboolean
+workspaceCurrentPainted (ScreenInfo *screen_info)
+{
+    GList *list;
+
+    for (list = screen_info->windows_stack; list; list = g_list_next (list))
+    {
+        Client *c = (Client *) list->data;
+
+        if ((c->win_workspace == screen_info->current_ws) &&
+            FLAG_TEST (c->xfwm_flags, XFWM_FLAG_VISIBLE) &&
+            !workspacePendingPaintDone (screen_info, c->window))
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static gboolean
+workspaceWithdrawPending (gpointer data)
+{
+    ScreenInfo *screen_info = (ScreenInfo *) data;
+    GList *list;
+    gboolean timed_out;
+
+    g_return_val_if_fail (screen_info != NULL, G_SOURCE_REMOVE);
+
+    timed_out = (g_get_monotonic_time () - screen_info->pending_withdraw_since) >=
+                ((gint64) WORKSPACE_WITHDRAW_MAX_MS * 1000);
+
+    if (!timed_out && !workspaceCurrentPainted (screen_info))
+    {
+        /* The windows shown on the new workspace have not painted yet: keep
+           the old workspace mapped so the compositor has content to show. */
+        return G_SOURCE_CONTINUE;
+    }
+
+    for (list = screen_info->pending_withdraw; list; list = g_list_next (list))
+    {
+        Window id = (Window) GPOINTER_TO_UINT (list->data);
+        Client *c = myScreenGetClientFromWindow (screen_info, id, SEARCH_FRAME);
+
+        if ((c != NULL) &&
+            (c->win_workspace != screen_info->current_ws) &&
+            FLAG_TEST (c->xfwm_flags, XFWM_FLAG_VISIBLE))
+        {
+            clientWithdraw (c, screen_info->current_ws, FALSE);
+        }
+    }
+
+    g_list_free (screen_info->pending_withdraw);
+    screen_info->pending_withdraw = NULL;
+    screen_info->pending_withdraw_timeout_id = 0;
+    workspaceClearPendingPaint (screen_info);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+workspaceWithdrawClient (ScreenInfo *screen_info, Client *c)
+{
+    g_return_if_fail (c != NULL);
+
+    if (!compositorIsActive (screen_info))
+    {
+        clientWithdraw (c, screen_info->current_ws, FALSE);
+        return;
+    }
+
+    /*
+     * Hide the window only after the windows mapped on the new workspace have
+     * painted.  With the compositor active, unmapping them in the same batch
+     * leaves the incoming windows without content for a frame and the
+     * compositor paints the root wallpaper in that gap.
+     */
+    screen_info->pending_withdraw =
+        g_list_prepend (screen_info->pending_withdraw, GUINT_TO_POINTER (c->frame));
+
+    if (screen_info->pending_withdraw_timeout_id == 0)
+    {
+        screen_info->pending_withdraw_since = g_get_monotonic_time ();
+        screen_info->pending_withdraw_timeout_id =
+            g_timeout_add (WORKSPACE_WITHDRAW_POLL_MS,
+                           workspaceWithdrawPending, screen_info);
+    }
+}
