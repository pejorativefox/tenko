// Tenko: wheel is the administrative group.  The installer creates the
// admin account in wheel (install.py _configure_users), so the default user
// gets passwordless flatpak management through this rule.
//
// Upstream's org.freedesktop.Flatpak.rules lets active local wheel users
// install and uninstall software from remotes without a password, but it
// leaves configure-remote and install-bundle at auth_admin.  The base
// desktop has no polkit authentication agent, so adding a system-wide remote
// used to fail with "Flatpak system operation ConfigureRemote not allowed for
// user", and installing a local .flatpak bundle could not prompt either
// (issue #29).  Wheel users can already edit /etc/yum.repos.d through sudo,
// so this is not a privilege change.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.Flatpak.configure-remote" ||
         action.id == "org.freedesktop.Flatpak.install-bundle") &&
        subject.active == true && subject.local == true &&
        subject.isInGroup("wheel")) {
            return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
