/usr/bin/gpu-screen-recorder
/usr/bin/gsr-cli
/usr/bin/gsr-kms-server
%dir /usr/include/gsr
/usr/include/gsr/plugin.h
/usr/lib/modprobe.d/gsr-nvidia.conf
/usr/lib/systemd/user/gpu-screen-recorder.service
%dir /usr/share/gpu-screen-recorder
%dir /usr/share/gpu-screen-recorder/scripts
/usr/share/gpu-screen-recorder/scripts/interactive.sh
/usr/share/gpu-screen-recorder/scripts/list-sinks.sh
/usr/share/gpu-screen-recorder/scripts/record-application-name.sh
/usr/share/gpu-screen-recorder/scripts/record-save-application-name.sh
/usr/share/gpu-screen-recorder/scripts/replay-application-name.sh
/usr/share/gpu-screen-recorder/scripts/save-recording.sh
/usr/share/gpu-screen-recorder/scripts/save-replay.sh
/usr/share/gpu-screen-recorder/scripts/start-recording.sh
/usr/share/gpu-screen-recorder/scripts/start-replay.sh
/usr/share/gpu-screen-recorder/scripts/start-stop-recording.sh
/usr/share/gpu-screen-recorder/scripts/stop-replay.sh
/usr/share/gpu-screen-recorder/scripts/toggle-recording-selected.sh
/usr/share/gpu-screen-recorder/scripts/toggle-recording.sh
/usr/share/gpu-screen-recorder/scripts/twitch-stream-local-copy.sh
/usr/share/gpu-screen-recorder/scripts/twitch-stream.sh
/usr/share/gpu-screen-recorder/scripts/youtube-hls-stream.sh
%doc /usr/share/man/man1/gpu-screen-recorder.1.gz
%doc /usr/share/man/man1/gsr-cli.1.gz
%doc /usr/share/man/man1/gsr-kms-server.1.gz
