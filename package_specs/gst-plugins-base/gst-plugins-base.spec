Name:       gst-plugins-base
Version:    1.28.8
Release:    2
Summary:    Base gstreamer plugins
License:    LGPL-2.1-or-later AND BSD-3-Clause
Source0:    %{name}-%{version}.tar.xz
Prefix:     /usr

%description
Base gstreamer plugins

%prep
%setup

%build
mkdir build
pushd build
meson setup ..               \
      --prefix=/usr          \
      --buildtype=release    \
      --wrap-mode=nodownload
ninja
popd

%install
rm -rf %{buildroot}
pushd build
DESTDIR=%{buildroot} ninja install
popd

