Remove the dangling check-examples dependency

tests/examples is a standalone CMake project and is never added with
add_subdirectory(), so the check-examples target does not exist in the
main build.  CMake 4 refuses to generate the build tree when a target
listed in add_dependencies() is missing.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -454,7 +454,7 @@
 endif()
 add_custom_target(check-qa DEPENDS ${CHECK_QA_TARGETS})
-add_dependencies(check check-qa check-examples)
+add_dependencies(check check-qa)
 # }}}
 
 INCLUDE(${CMAKE_SOURCE_DIR}/Packaging.cmake)
