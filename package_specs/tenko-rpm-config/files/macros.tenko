# tenko RPM macros for the build container.
# Installed by tenko-rpm-config; do not edit in the container.

%_prefix            /usr
%_lib               /usr/lib64
%_libdir            /usr/lib64
%_unitdir           /usr/lib/systemd/system
%_udevrulesdir      /usr/lib/udev/rules.d
# Match the installed system: runtime package sets do not ship this macro
# package, so their RPM database stays at the rpm default.  Keeping the build
# image on the same path means installing tenko-osdev/tenko-base-build on a
# running system cannot hide the existing database behind a new %_dbpath.
%_dbpath            /var/lib/rpm

# Standard runpaths (e.g. /usr/lib64) are acceptable for tenko.
%__brp_check_rpaths %{nil}

# .pc files are development metadata.  Keep their pkgconfig(...) Requires out
# of the binary package: the ELF Requires still cover the real runtime
# dependencies, and a runtime install must not pull development packages.
%__requires_exclude_from ^%{_libdir}/pkgconfig/.*\.pc$

# tenko does not ship debuginfo packages.
%_enable_debug_packages 0
%_build_id_links        none

# Python byte-compile failures in test fixtures must not abort packaging.
%_python_bytecompile_errors_terminate_build 0
