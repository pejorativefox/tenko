### Load the BlueZ 5 modules installed by pulseaudio-bluez.
### The pulseaudio package is built with bluez5=disabled, so its default.pa
### has no Bluetooth block; this snippet adds it without editing default.pa.
.ifexists module-bluetooth-policy.so
load-module module-bluetooth-policy
.endif

.ifexists module-bluetooth-discover.so
load-module module-bluetooth-discover
.endif
