 import sys
 _ = None
 
+# The upstream suite uses the alias removed in Python 3.12.
+unittest.TestCase.assertEquals = unittest.TestCase.assertEqual
+
+# Unit fixtures assume Debian's legacy service assignments. IANA registers
+# additional protocols and does not include the fsp alias. Keep these four
+# fixture names deterministic without changing the builder's /etc/services.
+import socket
+_getservbyname = socket.getservbyname
+_services = {
+    'tcpmux': (1, 'tcp'),
+    'fsp': (21, 'udp'),
+    'smtp': (25, 'tcp'),
+    'tftp': (69, 'udp'),
+}
+
+def _fixture_getservbyname(name, protocol=None):
+    if name not in _services:
+        return _getservbyname(name, protocol) if protocol else _getservbyname(name)
+    port, expected = _services[name]
+    if protocol is not None and protocol != expected:
+        raise OSError('service/proto not found')
+    return port
+
+socket.getservbyname = _fixture_getservbyname
+
 topdir = "./tests/unit/tmp"
 
 
