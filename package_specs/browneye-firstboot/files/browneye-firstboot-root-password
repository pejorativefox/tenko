#!/bin/sh
# Browneye first-boot root password setup (E5).
#
# Runs once, on tty1, only when the root account is locked or has no
# password.  Images that already carry a root password are left alone.  On
# success (or when a password is already present) a marker is written so the
# service does not run again even if root is locked later by an administrator.
set -eu

marker=/var/lib/browneye/firstboot-root-password.done

if [ -e "$marker" ]; then
    exit 0
fi

status=$(passwd -S root 2>/dev/null | awk '{print $2}' || true)

case "${status:-}" in
    L|NP|"")
        printf '\n'
        printf 'Browneye Linux first boot: the root account has no password.\n'
        printf 'Choose a root password now.  You can change it later with passwd.\n'
        printf '\n'
        if ! passwd root; then
            printf '\nRoot password was not set; it can be set later with passwd root.\n'
            exit 1
        fi
        mkdir -p /var/lib/browneye
        printf 'root password set by browneye-firstboot on %s\n' \
            "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$marker"
        printf '\nRoot password set.\n'
        ;;
    *)
        # P (usable password), PS (password set, no aging), etc.
        mkdir -p /var/lib/browneye
        printf 'root already has a password; first-boot setup skipped on %s\n' \
            "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$marker"
        ;;
esac
