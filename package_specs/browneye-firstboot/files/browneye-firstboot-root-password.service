[Unit]
Description=Browneye first-boot root password setup (tty1)
Documentation=file:///usr/share/doc/browneye-firstboot/README
ConditionPathExists=!/var/lib/browneye/firstboot-root-password.done
ConditionPathExists=/dev/tty1
After=local-fs.target
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/browneye-firstboot-root-password
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
