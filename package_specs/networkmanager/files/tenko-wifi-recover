#!/bin/sh
# Tenko: recover Wi-Fi after the wired link goes away.
#
# A Wi-Fi device can show "connected" and still pass no traffic once the
# cable is pulled: the access point dropped the quiet client while the
# wired link was preferred, or the radio idled through the handover.
# NetworkManager keeps the profile active and never re-associates on its
# own.  When a wired device goes down or loses carrier, probe the gateway
# over each connected Wi-Fi device and re-associate the ones that do not
# answer.

export PATH=/usr/bin:/usr/sbin:/bin:/sbin

[ "$#" -ge 2 ] || exit 0

dev=$1
action=$2

case $action in
    down | no-carrier) ;;
    *) exit 0 ;;
esac

case $dev in
    en* | eth*) ;;
    *) exit 0 ;;
esac

for entry in $(nmcli -g DEVICE,TYPE device 2>/dev/null); do
    [ "${entry#*:}" = wifi ] || continue
    wdev=${entry%%:*}
    state=$(nmcli -g GENERAL.STATE device show "$wdev" 2>/dev/null)
    [ "$state" = connected ] || continue
    gw=$(nmcli -g IP4.GATEWAY device show "$wdev" 2>/dev/null | head -n 1)
    [ -n "$gw" ] || continue
    # Let routing and ARP settle after the unplug before judging the link.
    sleep 3
    if ! ping -I "$wdev" -c 2 -W 2 "$gw" > /dev/null 2>&1; then
        nmcli device disconnect "$wdev" > /dev/null 2>&1 || :
        nmcli device connect "$wdev" > /dev/null 2>&1 || :
    fi
done

exit 0
